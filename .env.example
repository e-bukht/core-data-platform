# P0-I2 local reference: PostgreSQL 18 Docker on localhost:5434.
# For the existing native PostgreSQL 12 installation, use the equivalent URLs on its port.
CORE_PLATFORM_ENVIRONMENT=local
CORE_PLATFORM_DATABASE_URL=postgresql+psycopg://coredata_runtime:local-runtime-only@localhost:5434/coredata
CORE_PLATFORM_MIGRATION_DATABASE_URL=postgresql+psycopg://coredata_migrator:local-migrator-only@localhost:5434/coredata
CORE_PLATFORM_LOG_LEVEL=INFO
CORE_PLATFORM_OPENAPI_ENABLED=true
CORE_PLATFORM_OIDC_ISSUER=http://localhost:8180/realms/core-data-platform
CORE_PLATFORM_OIDC_AUDIENCE=core-data-api
CORE_PLATFORM_OIDC_ALLOWED_ALGORITHMS=RS256
CORE_PLATFORM_OIDC_JWKS_TTL_SECONDS=300
CORE_PLATFORM_OIDC_CLOCK_SKEW_SECONDS=30
CORE_PLATFORM_TENANT_HEADER=X-Tenant-Id
CORE_PLATFORM_CORRELATION_HEADER=X-Correlation-Id
# P0-I4 vendor-neutral OpenTelemetry reference.
# Start the local Collector with:
# docker compose -f deploy/local/compose.yaml --profile telemetry up -d otel-collector
CORE_PLATFORM_OTEL_ENABLED=false
CORE_PLATFORM_OTEL_SERVICE_NAME=core-data-platform
CORE_PLATFORM_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
CORE_PLATFORM_OTEL_TRACE_SAMPLE_RATIO=1.0
CORE_PLATFORM_OTEL_METRIC_EXPORT_INTERVAL_MILLIS=5000
CORE_PLATFORM_OTEL_GRPC_PORT=4317
CORE_PLATFORM_OTEL_HTTP_PORT=4318
CORE_PLATFORM_OTEL_HEALTH_PORT=13133

# Non-secret identifier for the active Evidence signing key.
CORE_PLATFORM_EVIDENCE_SIGNING_KEY_ID=local-ed25519-01

# Evidence Ed25519 signing key.
# Base64-encoded PKCS#8 DER. Secret value must not be committed.
CORE_PLATFORM_EVIDENCE_SIGNING_PRIVATE_KEY_B64=